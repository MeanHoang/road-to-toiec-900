# Config web app của Firebase — lấy ở Console → Project settings → General →
# Your apps → SDK setup and configuration.
#
# Mấy giá trị này là PUBLIC, lộ ra không sao. Bảo mật nằm ở firestore.rules.
# Trên Vercel: Settings → Environment Variables, dán từng biến vào.
#
# BỎ TRỐNG cũng chạy được: app rơi về localStorage và nội dung JSON trong repo.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Token Hugging Face loại fine-grained, chỉ quyền Write vào dataset mhoang0000/toeic900-assets.
# npm run push-assets đọc biến này để đẩy media lên CDN. Tạo ở huggingface.co/settings/tokens.
HF_TOKEN=
