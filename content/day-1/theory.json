    {
      "id": "d1-t-aspects",
      "type": "aspects",
      "title": "Bốn yếu tố khi tả tranh người",
      "items": [
        {
          "id": "d1-t-aspect-subject",
          "title": "Chủ thể",
          "en": "subject",
          "lines": [
            "Tranh 1 người: he/she, a person/man/woman, hoặc danh từ chỉ người — a pedestrian, a worker, a customer…",
            "Tranh nhiều người: They, Some people/men/women/passengers/children/shoppers…",
            "Chỉ một nhóm cụ thể trong tranh: One of / Two of / Some of the people…"
          ]
        },
        {
          "id": "d1-t-aspect-action",
          "title": "Hành động",
          "en": "action",
          "lines": [
            "Dùng nhiều nhất: S + is/are + V_ing + place (hiện tại tiếp diễn, chủ động).",
            "Ngoài ra: hiện tại đơn S + is/are + place.",
            "Và: There + is/are + N + place."
          ]
        },
        {
          "id": "d1-t-aspect-location",
          "title": "Vị trí",
          "en": "location",
          "lines": [
            "Giới từ, trạng từ chỉ vị trí và danh từ chỉ địa điểm — xem bảng bên dưới."
          ]
        },
        {
          "id": "d1-t-aspect-clothing",
          "title": "Trang phục",
          "en": "clothing",
          "lines": [
            "Quần áo: shirt, jacket, coat, suit…  Mũ: hat, cap.  Giày: shoes, boots.",
            "Phụ kiện: tie, glasses, scarf, headphones…",
            "Động từ hay dùng: wear, put on, try on, take off."
          ]
        }
      ],
      "source": "pdf"
    },
